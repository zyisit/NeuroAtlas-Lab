{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroatlas-lab.org/schemas/dataset.schema.json",
  "title": "Dataset",
  "type": "object",
  "required": [
    "id",
    "name",
    "provider",
    "version",
    "source_url",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "species": {
      "type": "string"
    },
    "modalities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string"
    },
    "citation": {
      "type": "string"
    },
    "checksum": {
      "type": "string"
    },
    "ingestion_metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
