{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroatlas-lab.org/schemas/source.schema.json",
  "title": "Source",
  "type": "object",
  "required": [
    "id",
    "title",
    "source_type",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publisher": {
      "type": "string"
    },
    "publication": {
      "type": "string"
    },
    "doi": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "source_type": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
