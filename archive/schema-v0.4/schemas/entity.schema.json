{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroatlas-lab.org/schemas/entity.schema.json",
  "title": "NeuroAtlas Entity",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "description",
    "version",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$"
    },
    "type": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_identifiers": {
      "type": "array",
      "items": {
        "$ref": "external-identifier.schema.json"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "deprecated",
        "proposed",
        "draft"
      ]
    }
  },
  "additionalProperties": false
}
