{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroatlas-lab.org/schemas/atlas.schema.json",
  "title": "Atlas",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "species",
    "coordinate_space",
    "version",
    "publisher",
    "source",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "Atlas"
    },
    "name": {
      "type": "string"
    },
    "species": {
      "type": "string"
    },
    "coordinate_space": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
