{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroatlas-lab.org/schemas/connection.schema.json",
  "title": "Connection",
  "type": "object",
  "required": [
    "id",
    "source",
    "target",
    "direction",
    "connection_type"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "direction": {
      "enum": [
        "directed",
        "bidirectional",
        "undirected",
        "unknown"
      ]
    },
    "connection_type": {
      "enum": [
        "anatomical_projection",
        "functional_connectivity",
        "structural_connectivity",
        "effective_connectivity",
        "synaptic_connection",
        "network_relationship"
      ]
    },
    "strength": {
      "type": "number"
    },
    "method": {
      "type": "string"
    },
    "species": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "moderate",
        "limited",
        "unknown"
      ]
    }
  },
  "additionalProperties": false
}
