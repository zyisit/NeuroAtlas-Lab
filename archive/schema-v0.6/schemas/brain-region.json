{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "brain-region.json", "title": "BrainRegion",
  "type": "object", "required": ["id", "name", "atlasMappingIds"], "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.json#/$defs/id" }, "name": { "$ref": "common.json#/$defs/nonEmptyString" }, "description": { "type": "string" },
    "atlasMappingIds": { "type": "array", "minItems": 1, "items": { "$ref": "common.json#/$defs/id" }, "uniqueItems": true }, "provenance": { "$ref": "common.json#/$defs/provenance" }
  }
}
