{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroatlas-lab.org/schemas/provenance.schema.json",
  "title": "Provenance Record",
  "type": "object",
  "required": [
    "id",
    "entity_id",
    "source_dataset",
    "source_version",
    "retrieval_date",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "source_dataset": {
      "type": "string"
    },
    "source_version": {
      "type": "string"
    },
    "source_identifier": {
      "type": "string"
    },
    "retrieval_date": {
      "type": "string",
      "format": "date"
    },
    "transformation": {
      "type": "string"
    },
    "transformation_version": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "checksum": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
