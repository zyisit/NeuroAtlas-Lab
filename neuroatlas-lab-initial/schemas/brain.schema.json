{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroatlas-lab.org/schemas/brain.schema.json",
  "title": "Brain",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "species",
    "reference_type",
    "atlas_id",
    "coordinate_space",
    "version",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "const": "Brain"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "species": {
      "type": "string"
    },
    "sex": {
      "type": "string"
    },
    "developmental_stage": {
      "type": "string"
    },
    "reference_type": {
      "enum": [
        "individual",
        "population_average",
        "reference_template",
        "probabilistic",
        "educational_model"
      ]
    },
    "atlas_id": {
      "type": "string"
    },
    "coordinate_space": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "deprecated",
        "proposed",
        "draft"
      ]
    },
    "external_identifiers": {
      "type": "array",
      "items": {
        "$ref": "external-identifier.schema.json"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
