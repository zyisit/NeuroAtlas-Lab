{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroatlas-lab.org/schemas/spatial-representation.schema.json",
  "title": "Spatial Representation",
  "type": "object",
  "required": [
    "id",
    "entity_id",
    "atlas_id",
    "coordinate_space",
    "representation_type",
    "format",
    "source",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "atlas_id": {
      "type": "string"
    },
    "coordinate_space": {
      "type": "string"
    },
    "representation_type": {
      "enum": [
        "surface_mesh",
        "volume",
        "voxel_mask",
        "probabilistic_map",
        "tractography",
        "coordinate",
        "point_cloud"
      ]
    },
    "asset_uri": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "checksum": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
