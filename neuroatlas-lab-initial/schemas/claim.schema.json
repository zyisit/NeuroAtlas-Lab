{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuroatlas-lab.org/schemas/claim.schema.json",
  "title": "Scientific Claim",
  "type": "object",
  "required": [
    "id",
    "subject",
    "predicate",
    "object",
    "evidence_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "object": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "species": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_status": {
      "enum": [
        "established",
        "well_supported",
        "supported",
        "emerging",
        "uncertain",
        "contested",
        "model_derived",
        "hypothetical"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
