{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "observation.json", "title": "Observation",
  "type": "object", "required": ["id", "observationType", "datasetVersionId"], "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.json#/$defs/id" }, "observationType": { "enum": ["measurement", "annotation", "derived", "reported"] }, "datasetVersionId": { "$ref": "common.json#/$defs/id" },
    "subjectId": { "$ref": "common.json#/$defs/id" }, "value": {}, "unit": { "type": "string" }, "method": { "type": "string" }, "spatialRepresentationId": { "$ref": "common.json#/$defs/id" }, "provenance": { "$ref": "common.json#/$defs/provenance" }
  }
}
